{
  "name": "gsd-cards",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop app that gives a graphical interface to the Claude CLI + gsd-core workflow: a hierarchical kanban board that mirrors your .planning/ artifacts in real time.",
  "license": "MIT",
  "author": "Felipe Stahlhofer",
  "homepage": "https://github.com/FelipeStahl/gsd-cards#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FelipeStahl/gsd-cards.git"
  },
  "bugs": {
    "url": "https://github.com/FelipeStahl/gsd-cards/issues"
  },
  "keywords": [
    "gsd",
    "gsd-core",
    "claude",
    "claude-cli",
    "kanban",
    "tauri",
    "desktop",
    "developer-tools"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "test:planning": "vitest run src/planning",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "fixtures:refresh": "node scripts/refresh-fixtures.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.4.0",
    "gray-matter": "^4.0.3",
    "i18next": "^26.3.6",
    "immer": "^11.1.15",
    "lucide-react": "^1.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "strip-ansi": "^7.2.0",
    "unified": "^11.0.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
